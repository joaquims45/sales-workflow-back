# Copy this file to .env and adjust values for your local setup.
# No real secrets should ever be committed here.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# If unset, the project falls back to a local sqlite database so it can
# run with zero external setup. Point this at Postgres for anything
# beyond a first smoke test (e.g. via docker-compose).
DATABASE_URL=postgres://sales_workflow:sales_workflow@localhost:5432/sales_workflow

# Where the FAISS product index is persisted. Defaults to ./data/faiss_index.bin.
# FAISS_INDEX_PATH=/data/faiss_index.bin

# Optional. Get a key at https://console.typesafe.ai. Without it, message
# routing (CONTINUE/SIDE_QUERY/REPLACE) always falls back to CONTINUE.
# TYPESAFE_API_KEY=
